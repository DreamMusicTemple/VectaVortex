  float2x2 rot(float a){ float c=cos(a), s=sin(a); return float2x2(c,-s,s,c); }
  float3 hsv(float3 c){ float3 p=abs(fract(c.xxx+float3(0.,2./3.,1./3.))*6.-3.); return c.z*gmix(float3(1.),gclamp(p-1.,0.,1.),c.y); }
  float3 pal(float t, float sh){ return .5+.5*cos(TAU*(t+sh+float3(0.,.33,.67))); }
  float2 P(){ return (fcoord-.5*uRes)/uRes.y; }
  float Jn(float n,float x){ x=gmax(abs(x),1e-4); if(x<8.5){ float s=0.,tm=pow(x*.5,n); float fact=1.; for(float i=2.;i<=n;i+=1.) fact*=i; if(n<1.) fact=1.; tm/=fact; s=tm; float h2=x*x*.25; for(int k=1;k<14;k++){ float fk=float(k); tm*=-h2/(fk*(fk+n)); s+=tm; } if(x<7.5) return s; float chi=x-n*PI*.5-PI*.25; float asy=sqrt(2./(PI*x))*(cos(chi)-(4.*n*n-1.)/(8.*x)*sin(chi)); return gmix(s,asy,(x-7.5)); }
  float chi=x-n*PI*.5-PI*.25; return sqrt(2./(PI*x))*(cos(chi)-(4.*n*n-1.)/(8.*x)*sin(chi)); }
  float field(float2 q){ float r=length(q), th=atan2(q.y,q.x); float h=0.; int M=int(U(1)); for(int m=0;m<4;m++){ if(m>=M) break; int b=2+m*4; if(m>=2) b=10+(m-2)*4; float n=U(b), k=U(b+1), a=U(b+2), ph=U(b+3); h+=a*Jn(n,k*r)*cos(n*th+ph); }
  h+=U(25)*exp(-r*r*6.)*cos(U(1)*3.+U(0)*2.); float rp=U(23)*sin(r*U(24)-U(0)*6.)*(1.-r)*.3; h+=rp; return h; }
  void main_(){ float2 p=P(); float R=U(29); float2 q=p/R; float r=length(q); q+=U(26)*.03*float2(sin(q.y*7.+U(0)),cos(q.x*7.-U(0)));
  float e=.012+U(18)*.02; float h=field(q); float hx=field(q+float2(e,0.))-field(q-float2(e,0.)), hy=field(q+float2(0.,e))-field(q-float2(0.,e)); float3 N=normalize(float3(-hx/(2.*e)*.25,-hy/(2.*e)*.25,1.));
  float crisp=U(31); float hh=gmix(h,sign(h)*pow(abs(h),.5),crisp*.5);
  float3 V=float3(0.,0.,1.); float3 Rv=reflect(-V,N); float fres=pow(1.-gclamp(dot(N,V),0.,1.),3.)*.8+.12;
  float3 deep=pal(U(22),0.)*.10, mid=pal(U(22)+.07,0.)*.55, crest=pal(U(22)+.15,0.)*1.05; float ht=.5+.5*tanh(hh*1.4);
  float3 body=gmix(deep,mid,gsmoothstep(.15,.6,ht)); body=gmix(body,crest,gsmoothstep(.55,.95,ht)); body*=.6+.5*gclamp(dot(N,normalize(float3(-.4,.5,.75))),0.,1.);
  float3 env=gmix(pal(U(22)+.5,0.)*.12,pal(U(22)+.1,0.)*.9,gsmoothstep(-.7,.9,Rv.y*.7+Rv.x*.3)); env+=pow(gmax(dot(Rv,normalize(float3(.5,.6,.65))),0.),50.)*float3(1.2,1.15,1.05)*U(30); env+=pow(gmax(dot(Rv,normalize(float3(-.6,-.3,.7))),0.),36.)*pal(U(22)+.3,0.)*.45;
  float cau=pow(gclamp(1.-abs(hh)*2.2,0.,1.),4.); body+=cau*pal(U(22)+.1,0.)*.5*U(21);
  float3 col=gmix(body,env,fres*U(20)); col+=pal(U(22)+.12,0.)*exp(-r*2.)*.05*U(21);
  float rim=gsmoothstep(.94,1.,r)*gsmoothstep(1.02,.98,r); col+=rim*pal(U(22)+.2,0.)*.7*(.3+U(19)); float disc=gsmoothstep(1.003,.99,r);
  float3 bg=pal(U(22)+.4,0.)*.03*(1.-length(p)*.5); col=gmix(bg,col,disc*(.6+.4*(1.-U(27)))); col+=U(21)*.2*pal(U(22)+.1,0.)*exp(-gmax(r-1.,0.)*9.)*gstep(1.,r); oC=float4(col,1.); }
};
