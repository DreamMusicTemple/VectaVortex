  for(int L=0;L<6;L++){ if(float(L)>=U(4)) break; float fl=float(L); float bins=floor(U(2)*(40.+fl*25.)); float ab=a/TAU*bins; float id=floor(ab); float fa=fract(ab)-.5; float h=h11(id+fl*91.7); float z=fract(h*7.+U(0)*(.35+.25*fl)+fl*.31);
    float rs=z*z*1.4; float len=U(1)*(.04+z*.5); float inR=gsmoothstep(rs-len,rs,r)*gsmoothstep(rs+.004,rs,r); float wid=.5/(1.+bins*.02)*(.35+z*.9); float inA=gsmoothstep(wid,.0,abs(fa)*(.4+r*3.));
    col+=pal(h*.6+U(3)+fl*.05,0.)*inR*inA*(.4+z*1.6)*U(7); }
  col+=exp(-r*5.)*U(5)*pal(U(3)+.2,0.)*.8; oC=float4(col,1.); }
