  float Jn(float n,float x){ x=gmax(abs(x),1e-4); if(x<8.5){ float s=0.,tm=pow(x*.5,n); float fact=1.; for(float i=2.;i<=n;i+=1.) fact*=i; if(n<1.) fact=1.; tm/=fact; s=tm; float h2=x*x*.25; for(int k=1;k<14;k++){ float fk=float(k); tm*=-h2/(fk*(fk+n)); s+=tm; } if(x<7.5) return s; float chi=x-n*PI*.5-PI*.25; float asy=sqrt(2./(PI*x))*(cos(chi)-(4.*n*n-1.)/(8.*x)*sin(chi)); return gmix(s,asy,(x-7.5)); }
  float chi=x-n*PI*.5-PI*.25; return sqrt(2./(PI*x))*(cos(chi)-(4.*n*n-1.)/(8.*x)*sin(chi)); }
  void main_(){ float2 p=P(); float R=U(29); float2 q=p/R; float r=length(q); float3 col=float3(.02);
  float h=0.; int M=int(U(1)); for(int m=0;m<3;m++){ if(m>=M) break; int b=2+m*4; h+=U(b+2)*Jn(U(b),U(b+1)*r)*cos(U(b)*atan2(q.y,q.x)+U(b+3)); }
  float2 L=normalize(float2(-.5,.7)); float lit=.55+.3*dot(normalize(q+1e-4),L)*r*U(31)+.1*h*U(25); float3 metal=gmix(float3(.055,.06,.07)+pal(U(14)+.05,0.)*.05*(.3+U(26)*3.),float3(.12,.125,.14)+pal(U(14)+.1,0.)*.09*(.3+U(26)*3.),gclamp(lit,0.,1.))*(1.-.35*r*r);
  metal+=.03*vn(p*180.)*U(25); float disc=gsmoothstep(1.004,.992,r); float rim=gsmoothstep(.95,1.,r)*gsmoothstep(1.03,.99,r); metal+=rim*.35*pal(U(14)+.3,0.)*U(31);
  float shadow=gsmoothstep(1.12,.99,length(q-float2(.05,-.06)))*(1.-disc)*.6*U(25); float3 bg=float3(.012,.012,.016)+.02*pal(U(14)+.5,0.); col=gmix(bg*(1.-shadow),metal,disc); oC=float4(col,1.); }
};
fragment float4 scene_sand_plate(QuadOut in [[stage_in]], constant float* K [[buffer(0)]]) { S_sand_plate s; s.K = K; s.fcoord = float2(in.pos.x, K[1] - in.pos.y); s.oC = float4(0.);  s.main_(); return s.oC; }
struct S_sandsim { constant float* K; float2 fcoord; float4 oC; texture2d<float> uState;
  float h21(float2 p){ float3 p3=fract(float3(p.xyx)*.1031); p3+=dot(p3,p3.yzx+33.33); return fract((p3.x+p3.y)*p3.z); }
  float Jn(float n,float x){ x=gmax(abs(x),1e-4); if(x<8.5){ float s=0.,tm=pow(x*.5,n); float fact=1.; for(float i=2.;i<=n;i+=1.) fact*=i; if(n<1.) fact=1.; tm/=fact; s=tm; float h2=x*x*.25; for(int k=1;k<14;k++){ float fk=float(k); tm*=-h2/(fk*(fk+n)); s+=tm; } if(x<7.5) return s; float chi=x-n*PI*.5-PI*.25; float asy=sqrt(2./(PI*x))*(cos(chi)-(4.*n*n-1.)/(8.*x)*sin(chi)); return gmix(s,asy,(x-7.5)); }
  float chi=x-n*PI*.5-PI*.25; return sqrt(2./(PI*x))*(cos(chi)-(4.*n*n-1.)/(8.*x)*sin(chi)); }
  float field(float2 q){ float r=length(q), th=atan2(q.y,q.x); float h=0.; int M=int(U(1)); for(int m=0;m<3;m++){ if(m>=M) break; int b=2+m*4; h+=U(b+2)*Jn(U(b),U(b+1)*r)*cos(U(b)*th+U(b+3)); } return h; }
  // U: 18 attraction (nodal pull), 19 vibration energy 0..1, 20 friction (per-second damping), 21 scatter, 22 mass, 23 settle(0 free..1 locked), 24 dt scale, 29 plate radius
void main_(){ float2 uv=fcoord/uStateRes; float4 s=uState.sample(smpN,float2((uv).x,1.-(uv).y)); float2 p=s.xy, v=s.zw; float id=h21(fcoord);
  if(s.x==0.&&s.y==0.&&s.z==0.&&s.w==0.){ float a=h21(fcoord+7.1)*6.2831853, r=sqrt(h21(fcoord+3.3))*.97; p=r*float2(cos(a),sin(a)); v=float2(0.); }
  float e=.006; float f0=field(p); float2 g=float2(field(p+float2(e,0.))-field(p-float2(e,0.)),field(p+float2(0.,e))-field(p-float2(0.,e)))/(2.*e);
  float2 force=-2.*f0*g*U(18)/gmax(U(22),.05);                                    // sand slides downhill on psi^2 toward the nodal lines
  float amp=abs(f0); float2 rnd=float2(h21(fcoord+uTime*13.7),h21(fcoord.yx-uTime*9.1))-.5;
  force+=rnd*(U(19)*(.15+3.*amp)*U(21)*9.)/gmax(U(22),.05)*(1.-U(23));          // vibration kicks (strongest on antinodes), scatter scales them, settling removes them
  force+=-p*0.0; v+=force*uDt*U(24); v*=exp(-U(20)*uDt); p+=v*uDt*U(24);
  float rr=length(p); if(rr>.985){ float2 n=p/rr; p=n*.985; float vn=dot(v,n); if(vn>0.) v-=1.6*vn*n; }
  oC=float4(p,v); }
};
fragment float4 sand_sim(QuadOut in [[stage_in]], constant float* K [[buffer(0)]], texture2d<float> st [[texture(0)]]) { S_sandsim s; s.K = K; s.fcoord = float2(in.pos.x, uStateRes.y - in.pos.y); s.uState = st; s.oC = float4(0.); s.main_(); return s.oC; }
