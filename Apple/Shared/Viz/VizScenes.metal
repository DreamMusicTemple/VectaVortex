  p+=U(6)*.3*float2(sin(p.y*3.+t),cos(p.x*3.-t)); float3 col=float3(0.); int N=int(U(5)); float wsum=0.; for(int i=0;i<6;i++){ if(i>=N) break; float fi=float(i); p=abs(p)/(dot(p,p)+.3)-.8-.1*sin(t*.3+fi); p=rot(.5+.1*sin(t*.2))*p; float m=length(p); float w=1./(1.+fi*.5); col+=pal(m*.45+fi*.13+U(3),0.)*w*gsmoothstep(.0,.8,m)*exp(-m*.4); wsum+=w; }
  col=col/gmax(wsum,1e-3)*1.5; col*=.85+U(7)*.3*sin(r*20.-t*3.); col*=gsmoothstep(1.4,.2,r)*.9+.1; oC=float4(col,1.); }
};
