  float2 q=float2(cos(a),sin(a))*U(4)*.45+float2(rho*.7,rho*.3); int o=int(U(7)); float n=fbm(q+U(6)*float2(fbm(q*2.+U(0),o),fbm(q*2.-U(0),o)),o);
  float streak=pow(gsmoothstep(.25,.9,n),1.5); float3 col=pal(n*.7+r*.4+U(3),0.)*streak*(1.-.5*exp(-r*3.))+pal(U(3)+.5,0.)*.06;
  col+=exp(-r*9.)*U(5)*pal(U(3)+.1,0.)*1.3+exp(-r*3.)*.12*U(5)*pal(U(3)+.3,0.); col*=gsmoothstep(1.3,.2,r)+.25; oC=float4(col,1.); }
};
