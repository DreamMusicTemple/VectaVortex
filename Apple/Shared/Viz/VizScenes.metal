  float h11(float p){ p=fract(p*.1031); p*=p+33.33; p*=p+p; return fract(p); }
  float h21(float2 p){ float3 p3=fract(float3(p.xyx)*.1031); p3+=dot(p3,p3.yzx+33.33); return fract((p3.x+p3.y)*p3.z); }
  float2 h22(float2 p){ float3 p3=fract(float3(p.xyx)*float3(.1031,.1030,.0973)); p3+=dot(p3,p3.yzx+33.33); return fract((p3.xx+p3.yz)*p3.zy); }
  float vn(float2 p){ float2 i=floor(p), f=fract(p); f=f*f*(3.-2.*f); return gmix(gmix(h21(i),h21(i+float2(1,0)),f.x),gmix(h21(i+float2(0,1)),h21(i+float2(1,1)),f.x),f.y); }
  float fbm(float2 p, int oct){ float s=0., a=.5; float2x2 m=float2x2(1.6,1.2,-1.2,1.6); for(int i=0;i<8;i++){ if(i>=oct) break; s+=a*vn(p); p=m*p; a*=.5; } return s; }
  float2x2 rot(float a){ float c=cos(a), s=sin(a); return float2x2(c,-s,s,c); }
  float3 hsv(float3 c){ float3 p=abs(fract(c.xxx+float3(0.,2./3.,1./3.))*6.-3.); return c.z*gmix(float3(1.),gclamp(p-1.,0.,1.),c.y); }
  float3 pal(float t, float sh){ return .5+.5*cos(TAU*(t+sh+float3(0.,.33,.67))); }
  float2 P(){ return (fcoord-.5*uRes)/uRes.y; }
  void main_(){ float2 p=P(); p.x-=U(7)*.15; float hz=U(1); float y=p.y-hz; float3 col=float3(0.);
  float3 skyA=pal(U(3)+.05,0.)*.25, skyB=pal(U(3)+.55,0.)*.9; col=gmix(skyB,skyA,gsmoothstep(0.,.8,y)); col*=gsmoothstep(-.02,.1,y)+.0;
  float sunY=hz+.22; float2 sp=float2(p.x,p.y-sunY); float sr=length(sp); float sun=gsmoothstep(U(4),U(4)-.01,sr); float bands=gstep(.0,sin((sp.y)*60.+U(0)*3.)+ (sp.y+U(4))*6.-.5); float3 sunC=gmix(pal(U(3)+.1,0.),pal(U(3)+.3,0.),gclamp((sp.y/U(4)+1.)*.5,0.,1.))*1.4;
  if(y>0.) col+=sun*sunC*gmix(1.,bands,gstep(sp.y,0.))+exp(-sr*3.)*pal(U(3)+.2,0.)*.35*(1.+U(5));
  float xs=(p.x+.5)*7.99; int bi=int(gclamp(xs,0.,7.)); float ph=0.; for(int k=0;k<8;k++) if(k==bi) ph=U(8+k); float ridge=hz+.02+.34*ph*gsmoothstep(.0,.5,abs(p.x))*(.5+.5*sin(p.x*18.));
  if(y>0.&&p.y<ridge&&abs(p.x)>.12) col=gmix(col,pal(U(3)+.75,0.)*.2,gsmoothstep(.0,.01,ridge-p.y)); 
  if(y<=0.){ float d=1./(-y+1e-3); float gx=p.x*d*.6; float gz=d*.5+U(0); float gl=U(2); float lx=abs(fract(gx*gl*.35)-.5), lz=abs(fract(gz*gl*.35)-.5); float line=1.-gsmoothstep(.0,.06+.04/(d*.4),gmin(lx,lz)); float3 gc=pal(U(3)+.6,0.);
    col=gc*.04+line*gc*(1.4+U(5))*U(6)*exp(-d*.012)+exp(-d*.5)*.0; col+=pal(U(3)+.1,0.)*.25*exp(y*6.); }
  oC=float4(col,1.); }
};
