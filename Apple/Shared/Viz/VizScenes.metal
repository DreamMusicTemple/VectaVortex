  float2x2 rot(float a){ float c=cos(a), s=sin(a); return float2x2(c,-s,s,c); }
  float3 hsv(float3 c){ float3 p=abs(fract(c.xxx+float3(0.,2./3.,1./3.))*6.-3.); return c.z*gmix(float3(1.),gclamp(p-1.,0.,1.),c.y); }
